# Copy this file to .env.local and fill these in.

# Google OAuth Web client ID. Get it from: Google Cloud Console >
#   APIs & Services > Credentials > OAuth 2.0 Client IDs > (your Web app client).
# The client ID is NOT a secret — it is meant to be embedded in the web app.
VITE_GOOGLE_CLIENT_ID=

# Token-broker / push Worker URL. Sign-in exchanges the auth code here for a
# persistent session, so this is REQUIRED (even in local dev). Point it at your
# deployed Worker, e.g. https://habitracker-push.<subdomain>.workers.dev
# (the Worker allows http://localhost:5173, so dev can use the same one).
VITE_PUSH_API=

# Public VAPID key for Web Push (optional locally; needed for reminders).
VITE_VAPID_PUBLIC_KEY=
